{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bancada",
  "version": "0.1.0",
  "identifier": "com.bancada.app",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/bancada-backend/**/*"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
